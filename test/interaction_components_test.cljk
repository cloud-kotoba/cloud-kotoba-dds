(ns interaction-components-test
  "tokens / menu / status — the interaction layer shared out of the products.

    kbb --backend sci --classpath src:test:../jp-go-digital-design-system/src:../text/src:../shinkansen/src test/interaction_components_test.cljk"
  (:require [cljs.test :refer [deftest is testing run-tests]]
            [kotoba.lang.text :as str]
            [cloud-kotoba-dds.tokens :as ck]
            [cloud-kotoba-dds.menu :as menu]
            [cloud-kotoba-dds.status :as status]
            [cloud-kotoba-dds.switch :as sw]
            [cloud-kotoba-dds.styles :as styles]
            [cloud-kotoba-dds.composer :as composer]
            [cloud-kotoba-dds.thread :as thread]
            [cloud-kotoba-dds.bots :as bots]
            [shinkansen.interaction :as interaction]
            [jp-go-dds.tokens :as tokens]))

(defn- flat [h] (tree-seq (fn [x] (or (vector? x) (seq? x))) seq h))
(defn- attrs-of [h] (->> (flat h) (filter map?) vec))
(defn- hig-asked [css] (set (map second (re-seq #"var\((--hig-[a-z0-9-]+)" css))))
(defn- ck-asked [css] (set (map second (re-seq #"var\((--ck-[a-z0-9-]+)" css))))

(deftest tokens-are-the-one-place-colour-is-derived
  (is (<= 20 (count ck/names)) (pr-str ck/names))
  (is (empty? (re-seq #"#[0-9a-fA-F]{3,8}\b" ck/css)) "no colour literal in the token layer")
  (is (= 4 (count (re-seq #"light-dark\(" ck/css))) "the four surface lifts live here (ground / raised / hover / border)")
  (is (empty? (remove (set (keys tokens/hig->dads)) (hig-asked ck/css))) "every --hig-* the tokens read is carried by the bridge")
  (is (str/includes? ck/css "prefers-reduced-motion") "motion has a floor"))

(deftest components-read-tokens-not-values
  (doseq [[nm css] {"bots" styles/bots-css "chat" styles/css "switch" sw/css "menu" menu/css "status" status/css
                    "composer" composer/css "thread" thread/css}]
    (testing nm
      (is (empty? (re-seq #"#[0-9a-fA-F]{3,8}\b" css)) "no colour literal")
      (is (empty? (re-seq #"light-dark\(" css)) "no surface derivation outside the token layer")
      (let [unknown (remove (set ck/names) (ck-asked css))
            ;; bots-css's own aliases are defined in bots-css itself
            unknown (remove #(str/starts-with? % "--ck-bots-") unknown)]
        (is (empty? unknown) (str "reads --ck-* the token layer does not define: " (pr-str unknown))))
      (is (empty? (remove (set (keys tokens/hig->dads)) (hig-asked css))) "every --hig-* is carried by the bridge"))))

(deftest floating-menu-is-a-menu
  (let [v (menu/floating {:id "m" :label "Bot の操作"
                          :items [{:label "ピン留め" :icon-path "M1 1" :action :bots/pin :params {:id "b"}}
                                  :separator
                                  {:label "削除" :action :bots/delete :params {:id "b"} :danger? true}
                                  {:label "Docs" :href "/docs"}]})
        a (attrs-of v)
        root (first a)
        items (filter #(= "menuitem" (:role %)) a)]
    (is (= "menu" (:role root)))
    (is (= "float" (:data-chrome root)) "the layer marker shinkansen.audit measures")
    (is (true? (:hidden root)) "rendered closed; the host shows it")
    (is (= 3 (count items)))
    (is (= ["bots/pin" "bots/delete" nil] (mapv :data-action items)))
    (is (= "{\"id\":\"b\"}" (:data-params (first items))))
    (is (str/includes? (:class (second items)) "ck-menu__item--danger"))
    (is (= "/docs" (:href (last items))) "a link item is an <a>")
    (is (= 1 (count (filter #(= "separator" (:role %)) a))))
    (is (every? #(= "-1" (:tabindex %)) items) "items are reached by arrow keys, not Tab")
    (is (= [] (interaction/undeclared-actions {:events {:bots/pin {} :bots/delete {}}} (pr-str v))))))

(deftest status-line-is-a-live-region-rendered-empty
  (let [[tag attrs & children] (status/line {:id "s" :label "結果"})]
    (is (= :p tag))
    (is (= "status" (:role attrs)))
    (is (= "polite" (:aria-live attrs)))
    (is (empty? children) "nothing to announce at load — a filled status would be idle theatre")
    (is (= "line" (:data-ck-status attrs)))))

(deftest runtimes-are-self-contained
  (doseq [needle ["cloudKotobaMenu" "role','menu'" "data-chrome','float'" "ArrowDown" "Escape" "pointerdown" "innerWidth" "opener"]]
    (is (str/includes? menu/script needle) needle))
  (doseq [needle ["cloudKotobaStatus" "aria-live" "data-tone" "setTimeout"]]
    (is (or (str/includes? status/script needle) (str/includes? status/css needle) (= needle "aria-live")) needle))
  (is (not (re-find #"fetch\(|localStorage|itonami" (str menu/script status/script))) "no product, no store, no network in the runtimes"))

(defmethod cljs.test/report [:cljs.test/default :end-run-tests] [m]
  (println "interaction-components-test" (select-keys m [:test :pass :fail :error]))
  (when-not (cljs.test/successful? m) (set! (.-exitCode js/process) 1)))


;; ---------- wave 2: composer + thread (2026-09-16, owner: 「1, 2, 3, 4」) ----------

(deftest composer-form-is-the-bots-composer-with-behaviour-hooks
  (let [v (composer/form {:id "f" :input-id "p" :label "依頼" :placeholder "頼む" :help "Enter で改行"
                          :maxlength 8000 :send-attrs {:id "send"} :stop-attrs {:id "stop"}})
        a (attrs-of v)
        root (first a)
        by (fn [k] (first (filter #(= k (:data-ck-bots %)) a)))]
    (is (= "bots/send" (:data-action root)) "submit names the bots vocabulary, not a second one")
    (is (= "autosize" (:data-ck-composer root)) "the marker the composer css keys on")
    (is (= "p" (:id (by "prompt"))))
    (is (= "p-help" (:aria-describedby (by "prompt"))))
    (is (= 8000 (:maxlength (by "prompt"))))
    (is (nil? (:disabled (by "send"))) "send is NOT rendered disabled (shinkansen.audit :idle-disabled)")
    (is (= ["送信" "追加で伝える"] [(:data-label-send (by "send")) (:data-label-more (by "send"))]) "labels are attributes a locale table can translate")
    (is (true? (:hidden (by "stop"))) "stop is hidden until a run is active")
    (is (= "bots/stop" (:data-action (by "stop"))))
    (is (contains? (:events bots/actions) :bots/stop) "bots/actions declares stop")
    (is (= [] (interaction/undeclared-actions bots/actions (pr-str v))))))

(deftest composer-runtime-carries-the-behaviour-not-the-words
  (doseq [needle ["cloudKotobaComposer" "requestSubmit" "isComposing" "keyCode!==229" "metaKey||ev.ctrlKey" "data-label-more" "closest('dialog')" "scrollHeight" "maxHeight"]]
    (is (str/includes? composer/script needle) needle))
  (is (not (re-find #"[぀-ヿ一-鿿]" composer/script)) "no Japanese in the runtime — the labels come from the markup"))

(deftest thread-bubble-carries-the-followup-anchor
  (let [[tag attrs & body] (thread/bubble {:role :person :followup-id "fu-1"} "追加で")]
    (is (= :div tag))
    (is (= "person" (:data-role attrs)))
    (is (= "fu-1" (:data-followup-id attrs)))
    (is (str/includes? (:class attrs) "ck-bots__bubble") "the bots pattern's bubble, not a second class")
    (is (= ["追加で"] body))))

(deftest thread-runtime-reads-the-frames-the-bot-loop-emits
  (doseq [needle ["cloudKotobaThread" "shinkansen.streamRun" "'delta'" "'followup-applied'" "'done'" "'error'" "data-followup-id" "AbortError" "dataset.markdown"]]
    (is (str/includes? thread/script needle) needle))
  (is (not (re-find #"phase|tool" thread/script)) "phases and tools are the host's frames, not the thread's"))


;; ---------- the conversation tone (2026-09-16, owner: 「grok bots や chat gpt のトンマナ」) ----------

(deftest chat-stylesheet-groups-by-surface-not-by-line
  (is (not (re-find #"border(-[a-z]+)?:\s*1px solid" styles/css)) "no dividing line: sidebar / toolbar / thread / composer separate by surface")
  (is (not (str/includes? styles/css "color-scheme:light")) "dark is the tokens' (light-dark), not forced off")
  (is (empty? (re-seq #"(?:border-radius|padding|gap|font-size|margin(?:-[a-z]+)?):[^;}]*\d+px" styles/css)) "radii, space and type are tokens, not px (focus rings and the 1px clip are the only px)")
  (doseq [needle ["--ck-radius-lg" "--ck-radius-pill" "--ck-shadow-float" "--ck-surface-hover" "[data-history=drawer]"]]
    (is (str/includes? styles/css needle) needle)))

(deftest lambda-toggle-is-the-kotoba-lang-mark-on-the-shinkansen-contract
  (let [[tag attrs & body] (sw/lambda-toggle {:label "Dark mode"})]
    (is (= :button tag))
    (is (= ["switch" "false" "kot-theme" "lambda-toggle" "Dark mode"]
           [(:role attrs) (:aria-checked attrs) (:id attrs) (:data-hydrate attrs) (:aria-label attrs)]))
    (is (true? (:hidden attrs)) "ships hidden; the runtime reveals it")
    (is (str/includes? (pr-str body) "kot-yy-fig") "the λ yin-yang figure, not a sun and a moon"))
  (doseq [needle ["hydrate('lambda-toggle'" "el.hidden=false" "shinkansen.theme.effective()==='dark'?'light':'dark'" "aria-checked"]]
    (is (str/includes? sw/script needle) needle))
  (is (str/includes? sw/lambda-css "#kot-theme")))

(run-tests)
