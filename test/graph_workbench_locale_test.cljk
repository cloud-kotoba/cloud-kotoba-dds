(ns graph-workbench-locale-test
  "Bilingual copy contract for the shared workbench: :locale :ja | :en on
   `view` (default :ja), JA nav labels for the Japanese rendering, English for
   the other, and the locked auth-gate helper still shipped in `script`.

    kbb --backend sci --classpath src:test:../jp-go-digital-design-system/src:../text/src:../shinkansen/src:../css/src:../html/src test/graph_workbench_locale_test.cljk"
  (:require [cljs.test :refer [deftest is testing run-tests]]
            [kotoba.lang.text :as str]
            [cloud-kotoba-dds.graph-workbench :as graph]))

(deftest ja-view-keeps-the-japanese-nav-labels
  (let [h (pr-str (graph/view {:locale :ja}))]
    (is (str/includes? h "概要") "Japanese rendering carries the JA nav labels")
    (is (str/includes? h "データム"))
    (is (not (str/includes? h "Overview"))
        "no English nav label leaks into the Japanese rendering")))

(deftest en-view-keeps-the-english-nav-labels
  (let [h (pr-str (graph/view {:locale :en}))]
    (is (str/includes? h "Overview") "English rendering carries the EN nav labels")
    (is (str/includes? h "Datoms"))
    (is (not (str/includes? h "概要"))
        "no Japanese nav label leaks into the English rendering")))

(deftest absent-locale-defaults-to-ja
  (is (= (pr-str (graph/view)) (pr-str (graph/view {:locale :ja})))
      "view with no options renders exactly the :ja copy")
  (is (= (pr-str (graph/view {})) (pr-str (graph/view {:locale :ja})))
      "an options map without :locale also renders the :ja copy"))

(deftest script-still-ships-the-auth-gate-helper
  (is (str/includes? graph/script "setAuthGateState"))
  (is (str/includes? graph/browser-source "setAuthGateState"))
  (is (str/includes? graph/script "function t(ja,en)"))
  (is (str/includes? graph/browser-source "root.getAttribute('lang')")))

(deftest runtime-translator-is-never-shadowed
  ;; 2026-09-25: renderGraph declared `var t=triple(...)` in its loop; `var`
  ;; hoists, so its first t('ノードを選択…') call threw "t is not a function"
  ;; and every data load stayed on "loading…" with no rows. Pin the name.
  (is (not (re-find #"var t=|,t=triple|var t =" graph/browser-source))
      "no local `t` may shadow the runtime translator")
  (is (str/includes? graph/browser-source "var tri=triple(")))

(deftest overview-leads-with-the-databases
  (let [h (pr-str (graph/overview-panel {:locale :ja}))]
    (is (< (str/index-of h "db-list-rows") (str/index-of h ":data-overview-metrics"))
        "the database list comes before usage metrics")
    (is (not (str/includes? h "最初の3 steps")))
    (is (not (str/includes? h "Content addressed GraphDB")) "how-it-works is one disclosure, not a card"))
  (let [v (pr-str (graph/view {}))]
    (is (str/includes? v ":datalist {:id \"kb-db-options\"}"))
    (is (str/includes? v ":list \"kb-db-options\""))))

(deftest intro-false-drops-the-workbench-heading
  (is (str/includes? (pr-str (graph/view {})) "kb-lead"))
  (is (not (str/includes? (pr-str (graph/view {:intro? false})) "kb-lead"))))

(deftest graph-panel-is-a-knowledge-map
  ;; 2026-09-25: the graph panel answers "what does this database know" —
  ;; kinds with counts and examples, a kind map, one kind's members, one
  ;; thing's facts — instead of raw datoms on a circle.
  (let [ja (pr-str (graph/view {:locale :ja})) en (pr-str (graph/view {:locale :en}))]
    (doseq [id ["km-summary" "km-kinds" "km-crumbs" "km-list" "km-entity" "km-incoming" "graph-view-svg" "graph-selection-rows"]]
      (is (str/includes? ja (str ":id \"" id "\"")) id))
    (is (str/includes? ja "ナレッジマップ"))
    (is (str/includes? en "Knowledge map"))
    (is (str/includes? ja ":value \"500\"") "the default window is large enough to see kinds"))
  (doseq [fn-name ["function buildModel()" "function drawMap()" "function showEntity(" "function renderSchema()"]]
    (is (str/includes? graph/browser-source fn-name) fn-name))
  (is (str/includes? graph/browser-source "function render(){buildModel();")
      "every view renders from the same model"))

(run-tests 'graph-workbench-locale-test)
