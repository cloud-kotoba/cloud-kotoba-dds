(ns shell-test
  "The shell chrome on the behavior layer (2026-09-16): the account entry is a
   jp-go-dds.behavior menu — the markers the runtime selects and the audit
   measures are on the markup, and the shell's own script only fills and
   reveals.

    kbb --backend sci --classpath src:test:../jp-go-digital-design-system/src:../text/src:../shinkansen/src:../css/src:../html/src test/shell_test.cljk"
  (:require [cljs.test :refer [deftest is testing run-tests]]
            [kotoba.lang.text :as str]
            [cloud-kotoba-dds.shell :as shell]
            [jp-go-dds.behavior :as behavior]
            [shinkansen.audit :as audit]
            [html.core :as html]))

(def entry
  (shell/account-entry {:id "account" :variant :rail :sign-in {:href "#in" :label "Sign in"} :menu-label "Account menu"
                        :items [{:href "#account" :label "Account"} {:id "sign-out" :action "sign-out" :label "Sign out"}]}))

(deftest the-account-entry-is-a-behavior-menu
  (let [h (html/->html entry)]
    (doseq [a ["data-behavior=\"menu\"" "data-menu-placement=\"up\"" "data-menu-opener" "aria-expanded=\"false\"" "aria-controls=\"account-menu\"" "aria-haspopup=\"menu\""
               "data-menu-popup" "data-chrome=\"float\"" "role=\"menu\"" "role=\"menuitem\""]]
      (is (str/includes? h a) a))
    (is (str/includes? h "<button type=\"button\" class=\"ck-account__chip\"") "the chip is a button, not a summary")
    (is (not (str/includes? h "<details")) "no details/summary: the menu is the runtime's")
    (is (= 2 (count (re-seq #"role=\"menuitem\"" h))))
    (is (not (str/includes? shell/script "Escape")) "the shell script no longer wires the menu — that is behavior/script's")))

(deftest the-audit-measures-the-entry-through-its-markers
  (let [doc (fn [scripts] (str "<html><head></head><body><main id=\"main\">" (html/->html entry) scripts "</main></body></html>"))
        ctx {:assets #{} :documents #{} :csp :none}
        ax (fn [r id] (first (filter #(= id (:id %)) (:axes r))))]
    (is (= 1.0 (:score (ax (audit/score-document {:file "e" :html (doc (str "<script>" behavior/script "</script>"))} ctx) :behaviors-delivered))))
    (is (str/includes? (:finding (ax (audit/score-document {:file "e" :html (doc "")} ctx) :behaviors-delivered)) "data-behavior=menu#account: no shipped script selects it"))
    (testing "the float layer still measures through chrome-layers with behavior/css"
      (is (= 1.0 (:score (ax (audit/score-document {:file "e" :html (str "<html><head><style>" behavior/css shell/css "</style></head><body><main id=\"main\">" (html/->html entry) "</main></body></html>")} ctx) :chrome-layers)))))))


(deftest the-document-is-the-one-structure-and-the-audit-measures-it
  ;; 2026-09-17 (owner direction, kotoba.cloud): the shell is emitted once,
  ;; here — skip → main [topbar · banner · body] → rail → footer — and the
  ;; :shell axis measures its markers on every document a host declares :app.
  (let [rail [:nav {:class "kc-sb" :aria-label "app"} [:a {:href "/a"} "A"]]
        body (shell/document {:skip {:label "本文へ"}
                              :topbar (shell/topbar {:section [:span "MAIN"] :actions [[:a {:href "/x"} "x"]]})
                              :banner [:div {:role "status" :hidden true} "resume"]
                              :rail rail
                              :footer [:footer {:class "f"} "f"]
                              :runtime [[:span {:id "copy" :hidden true}]]
                              :main {:class "kc-sb-main"}}
                             [:h1 "Page"] [:p "body"])
        pretty (html/->html (into [:body] body))
        ;; html.core pretty-prints; the order is asserted on the flat form
        h (str/replace pretty #"\n\s*" "")
        ctx {:assets #{} :documents #{} :csp :none :shell :app}
        ax (fn [r id] (first (filter #(= id (:id %)) (:axes r))))
        report (audit/score-document {:file "d" :html (str "<html><head><style>" shell/css "</style></head>" pretty "</html>")} ctx)]
    (testing "the order: skip, runtime, main (topbar first inside), rail, footer"
      (is (str/starts-with? h "<body><a class=\"ck-skip dads-button\" data-type=\"outline\" data-size=\"sm\" href=\"#main\">本文へ</a><span id=\"copy\" hidden></span><main id=\"main\" class=\"kc-sb-main\"><header class=\"ck-topbar\" data-chrome=\"top\">"))
      (is (< (str/index-of h "<main") (str/index-of h "data-chrome=\"rail\"") (str/index-of h "<footer")))
      (is (str/includes? h "<nav class=\"kc-sb\" aria-label=\"app\" data-chrome=\"rail\">") "the app's nav, the marker stamped on it")
      (is (str/includes? h "<h1>Page</h1><p>body</p></main>") "the body follows the banner inside main"))
    (testing "the :shell axis passes this structure and names what a hand-composed page lacks"
      (is (= 1.0 (:score (ax report :shell))))
      (is (= 1.0 (:score (ax report :skip-link))))
      (let [bare (audit/score-document {:file "b" :html "<html><body><header><nav class=\"kc-nav\"><a href=\"/x\">x</a></nav></header><main id=\"main\"><h1>x</h1></main></body></html>"} ctx)]
        (is (str/starts-with? (:finding (ax bare :shell)) "no nav[data-chrome=rail]"))
        (is (str/includes? (:finding (ax bare :shell)) "no data-chrome=top bar"))))
    (testing "refusals by name"
      (is (thrown-with-msg? js/Error #"shell/document: :rail is required"
                            (doall (shell/document {:skip {:label "s"}} [:p "x"]))))
      (is (thrown-with-msg? js/Error #"shell/document: :rail must be a \[:nav …\] root"
                            (doall (shell/document {:skip {:label "s"} :rail [:div "not a nav"]} [:p "x"]))))
      (is (thrown-with-msg? js/Error #"shell/document: :skip \{:label\} is required"
                            (doall (shell/document {:rail rail} [:p "x"])))))
    (testing "a rail without an attribute map still gets the marker"
      (is (str/includes? (html/->html (into [:body] (shell/document {:skip {:label "s"} :rail [:nav [:a {:href "/a"} "A"]]} [:p "x"])))
                         "<nav data-chrome=\"rail\">")))))

(run-tests)
