{:system/id :cloud-kotoba-dds
 :system/version "0.3.0-alpha"
 :system/status :reusable-chat-components-and-study
 :foundation :jp-go-dds
 :production-adoption {:chat-components ["network-awai/cloud-murakumo-site"] :other-study-components :not-started}
 :locales {:implemented ["ja" "en"]
           :ui-independent-of [:source-language :reply-language]
           :selection-order [:explicit-url :saved-user-choice :default]
           :default "ja"
           :untranslated-reference {:visible-notice true :lang-attribute true}
           :future ["BCP47 locale negotiation" "RTL" "localized dates and quantities" "translation catalog coverage gate"]}
 :components
 {:graph-workbench {:status :development :api "GRAPH_COMPONENTS.md"
                     :source "src/cloud_kotoba_dds/graph_workbench.cljk"
                     :host-owns [:authentication :transport :billing :readiness]
                     :snapshot-limits {:rows 100 :nodes 40 :edges 80}
                     :live-tenant-qualified false}
  :language-selector {:base :jp-go-dds/language-selector
                      :preserves [:draft :route :source-content :reply-language]
                      :keys [:escape :arrow-up :arrow-down :home :end :enter]
                      :focus-return :opener}
  :account-entry {:variants [:rail :compact-header :catalog]
                  :action :open-settings-sheet :accessible-name-required true
                  ;; the reusable chip + floating menu (0.1.0): both states
                  ;; emitted server-side, the host fills and reveals
                  :component :shell/account-entry
                  :menu :floating-popover
                  :menu-keys [:escape] :menu-outside-click :close
                  :focus-return :chip}
  :shell {:status :reusable :api "SHELL_COMPONENTS.md"
          :source "src/cloud_kotoba_dds/shell.cljk"
          :parts [:topbar :account-entry]
          :layers {:topbar :sticky-top :account-menu :floating-popover}
          :markers {:topbar "data-chrome=top" :account-menu "data-chrome=float"}
          :measured-by :shinkansen.audit/chrome-layers
          :host-owns [:section-facts :chips :session-facts :sign-out :rail-geometry]
          :production-adoption ["kotoba-lang/app-kotoba-cloud"]}
  :code-block {:status :reusable :api "CODE_COMPONENTS.md"
               :source "src/cloud_kotoba_dds/code.cljk"
               :parts [:block :inline]
               :languages [:bash :json :clojure :http :text]
               :highlighting :server-side-tokens
               :overflow {:default :wrap :option :scroll-focusable}
               :markers {:pre "data-lang" :code "class=language-<x>"}
               :measured-by [:shinkansen.audit/code-language :shinkansen.audit/pre-overflow]
               :contrast {:floor 4.5 :surfaces [:light :dark] :verified "test/code.mjs"}
               :copy {:control :hidden-until-runtime :reads :pre-text-content :announce :aria-live}
               :host-owns [:labels :script-file :which-blocks-scroll]
               :production-adoption ["kotoba-lang/app-kotoba-cloud"]}
  :settings-sheet {:element :dialog :modality :modal
                   :compact :bottom-sheet :expanded :center-dialog
                   :initial-focus :heading :escape :close-and-return-focus
                   :backdrop-click :no-action
                   :gesture-only-actions false
                   ;; the component (2026-09-16): cloud-kotoba-dds.sheet on
                   ;; jp-go-dds.behavior's dialog — the platform's trap /
                   ;; Escape / focus return, DADS modal-dialog markup
                   :status :reusable :component :sheet/settings-sheet
                   :source "src/cloud_kotoba_dds/sheet.cljk"
                   :behavior :jp-go-dds.behavior/dialog
                   :measured-by :shinkansen.audit/behaviors-delivered}
  :theme {:status :reusable :source "src/cloud_kotoba_dds/theme.cljk"
          ;; the default tokens and document defaults of every Kotoba app:
          ;; the --hig-* contract as jp-go-dds's bridge (128), the chrome
          ;; defaults app.itonami.cloud's bots app set by hand, the one
          ;; stylesheet and the scripts a host ships, light / dark / system
          ;; on the shinkansen contract (default system)
          :tokens :jp-go-dds.tokens/hig->dads
          :theme-contract :shinkansen.theme
          :default-mode :system
          :production-adoption ["kotoba-lang/app-kotoba-cloud"]}
  :behavior {:runtime :jp-go-dds.behavior/script
             :markers [:dialog :menu :tabs :disclosure :radiogroup :toast :combobox]
             :hosts [:shell/account-entry :switch/theme-switch :sheet/settings-sheet]
             :measured-by :shinkansen.audit/behaviors-delivered}
  :composer {:states [:idle :invalid :offline :running :complete]
             :enter :newline :meta-or-ctrl-enter :try-sample
             :ime-composition :never-submit
             :draft-storage :explicit-opt-in :default-persistence false
             :pending-edit-policy :preserve-newer-edits
             :empty-submit :inline-message-and-focus
             :duplicate-submit :blocked-while-running
             :effects :local-simulation-only}
  :navigation {:views [:workspace :content :components :behavior]
               :addressing :fragment :current :aria-current-page
               :focus-target :view-container :full-document-navigation false}
  :run-status {:announcement :polite-atomic
               :sound-default :off :simulation-label-required true}
  :content-link {:content-id :cidv1-raw-sha256 :ui-locale-changes-content false
                 :authority :none :network-resolution :not-implemented}
  :motion {:press-ms 100 :reveal-ms 180 :panel-ms 240
            ;; the same three numbers are --hig-motion-press / -reveal /
            ;; -panel (jp-go-dds.tokens/motion); theme_test asserts equality
            :source :jp-go-dds.tokens/motion
            :reduced-motion [:system :user] :reduced-behavior :immediate}}
 :touch {:target-css-px 44 :coarse-pointer-target-css-px 48
         :touch-action :manipulation :drag-only-actions false
         :scroll-capture false :native-selection-preserved true
         :native-zoom-preserved true :native-edge-back-preserved true}
 :verification {:automated-viewport-targets [320 360 390 768 1280]
                ;; the width bands are jp-go-dds.tokens/breakpoints =
                ;; shinkansen.viewport/breakpoints (theme_test asserts)
                :bands :jp-go-dds.tokens/breakpoints
                :device-required [:ios-safari-keyboard :android-chrome-keyboard :voiceover :talkback]
                :not-certified [:rtl :all-colors-contrast :real-device-ime :haptics]}}
