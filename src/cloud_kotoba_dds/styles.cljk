(ns cloud-kotoba-dds.styles)

(def css
  "Shared conversation layout. Load after the jp-go-dds token bridge."
  "\n[hidden]{display:none!important}\n.go-shell{display:flex;flex-direction:column;height:calc(100dvh - 5rem);min-height:36rem;max-height:64rem;border:1px solid var(--hig-color-separator);border-radius:var(--hig-radius-lg);background:var(--hig-color-system-background);overflow:hidden}\n.go-toolbar,.go-model-row,.go-compose-actions{display:flex;align-items:center;gap:var(--hig-spacing-3);padding:var(--hig-spacing-3) var(--hig-spacing-4);flex-wrap:wrap}\n.go-toolbar{justify-content:space-between;border-bottom:1px solid var(--hig-color-separator)}\n.go-free{margin-inline-start:var(--hig-spacing-3);color:var(--hig-color-secondary-label);font-size:var(--hig-text-caption1-font-size)}\n.go-model-row{font-size:var(--hig-text-footnote-font-size)}\n[data-ck-chat=\"model\"]{max-width:100%;min-width:0;flex:1}\n.go-model-row small{flex-basis:100%;color:var(--hig-color-secondary-label)}\n.go-conversation{position:relative;flex:1;min-height:0;display:flex;flex-direction:column}\n.go-welcome{margin:auto;text-align:center;padding:var(--hig-spacing-6) var(--hig-spacing-4)}\n.go-welcome h1{font-size:var(--hig-text-title1-font-size)}\n.go-mark{color:var(--hig-color-tint);font-size:var(--hig-text-large-title-font-size)}\n[data-ck-chat=\"messages\"]{overflow-y:auto;overscroll-behavior:contain;flex:1;min-height:0;padding:var(--hig-spacing-4);scrollbar-gutter:stable}\n[data-ck-chat=\"messages\"]:empty{flex:0;padding:0}\n.go-message{max-width:46rem;margin:0 auto var(--hig-spacing-5);min-width:0;overflow-wrap:anywhere}\n.go-user{background:var(--hig-color-secondary-system-background);border-radius:var(--hig-radius-lg);padding:var(--hig-spacing-4);max-width:38rem;margin-inline-end:0}\n.go-role{display:block;font-weight:600;margin-bottom:var(--hig-spacing-2);font-size:var(--hig-text-footnote-font-size)}\n.go-text{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.7}\n.go-image{display:block;max-width:100%;height:auto;border-radius:var(--hig-radius-md)}\n.go-steps{display:flex;flex-wrap:wrap;gap:var(--hig-spacing-2);padding:0;list-style:none;font-size:var(--hig-text-caption1-font-size);color:var(--hig-color-secondary-label)}\n.go-steps li{border-bottom:2px solid var(--hig-color-separator);padding-block:var(--hig-spacing-2)}\n.go-steps [data-state=current]{color:var(--hig-color-tint);border-color:currentColor;font-weight:600}\n.go-steps [data-state=done]::before{content:'✓ ';}\n.go-turn-status{font-size:var(--hig-text-footnote-font-size);color:var(--hig-color-secondary-label)}\n[data-failed=true] .go-turn-status{color:var(--hig-color-label)}\n.go-actions{display:flex;align-items:center;flex-wrap:wrap;gap:var(--hig-spacing-3);margin-block:var(--hig-spacing-3)}\n.go-actions small{flex-basis:100%;overflow-wrap:anywhere}\n.go-composer{flex-shrink:0;border-top:1px solid var(--hig-color-separator);padding:var(--hig-spacing-3) var(--hig-spacing-4);padding-bottom:max(var(--hig-spacing-3),env(safe-area-inset-bottom))}\n[data-ck-chat=\"prompt\"]{display:block;width:100%;box-sizing:border-box;min-height:3rem;max-height:180px;resize:none;font-size:var(--hig-text-body-font-size);margin-top:var(--hig-spacing-2)}\n.go-compose-actions{padding-inline:0}.go-compose-actions small{margin-inline-start:auto;color:var(--hig-color-secondary-label)}\n.go-consent{display:flex;gap:var(--hig-spacing-2);align-items:flex-start;font-size:var(--hig-text-caption1-font-size);line-height:1.5}.go-consent input{flex-shrink:0;min-width:1.25rem;min-height:1.25rem}\n[data-ck-chat=\"status\"]{min-height:1.5em;margin:var(--hig-spacing-2) 0 0;font-size:var(--hig-text-caption1-font-size)}\n.go-latest{position:absolute;bottom:var(--hig-spacing-2);right:var(--hig-spacing-4)}\n.go-about{margin-block:var(--hig-spacing-5)}\n@media(max-width:600px){.ap:has(.go-shell){padding-inline:var(--hig-spacing-2);padding-top:var(--hig-spacing-2)}.go-shell{height:calc(100dvh - 4.5rem);min-height:30rem;border-radius:var(--hig-radius-md)}.go-toolbar,.go-model-row{padding:var(--hig-spacing-2) var(--hig-spacing-3)}.go-toolbar button{min-height:44px}.go-toolbar .go-free{display:none}.go-composer{padding-inline:var(--hig-spacing-3)}.go-compose-actions small{display:none}.go-compose-actions{justify-content:space-between}[data-ck-chat=\"messages\"]{padding:var(--hig-spacing-3)}.go-welcome{padding:var(--hig-spacing-3)}.go-welcome h1{font-size:var(--hig-text-title2-font-size)}.go-model-row small{margin:0}.go-consent{max-height:4.5rem;overflow:auto}}\n@media(max-height:600px){.go-shell{min-height:24rem}.go-welcome{display:none}.go-consent{max-height:3rem;overflow:auto}}\n\n.go-shell{color-scheme:light}\n.go-shell :focus-visible{outline:2px solid var(--hig-color-tint);outline-offset:3px}\n.go-composer{padding-left:max(var(--hig-spacing-3),env(safe-area-inset-left));padding-right:max(var(--hig-spacing-3),env(safe-area-inset-right))}\n.go-toolbar{padding-top:max(var(--hig-spacing-3),env(safe-area-inset-top))}\n@media(max-width:600px){.go-toolbar{flex-wrap:nowrap}.go-toolbar button{padding:var(--hig-spacing-2);white-space:nowrap}.go-compose-actions{flex-wrap:nowrap}.go-consent{max-height:none;overflow:visible}}\n.chat-workspace [data-ck-chat=\"model\"]{min-height:44px;border:1px solid var(--hig-color-separator);border-radius:10px;padding:8px;background:white;color:var(--hig-color-label);font-size:14px}\n.chat-workspace [data-ck-chat=\"history-toggle\"]{border:0;border-radius:10px;background:var(--hig-color-secondary-system-background);padding:8px 12px;color:var(--hig-color-label)}\n.chat-policy{max-width:min(640px,calc(100vw - 32px));max-height:80dvh;border:1px solid var(--hig-color-separator);border-radius:20px;padding:20px;overflow:auto}.chat-policy button{min-height:44px}.chat-policy::backdrop{background:rgb(0 0 0 / 40%)}\n/* Conversation workspace: history, messages and a persistent composer. */\nbody:has(.chat-workspace){overflow:hidden}.chat-workspace{display:grid;grid-template-columns:250px minmax(0,1fr);height:calc(100dvh - 65px);max-width:none!important;padding:0!important;margin:0!important;position:relative}.chat-sidebar{display:flex;flex-direction:column;padding:16px;background:var(--hig-color-secondary-system-background);border-right:1px solid var(--hig-color-separator);min-height:0;gap:12px}.chat-sidebar h2{font-size:14px;margin:8px}.chat-sidebar button{min-height:48px;border:0;border-radius:10px;text-align:left;padding:10px 12px;background:transparent;color:var(--hig-color-label);font:inherit}.chat-sidebar [data-ck-chat=\"new\"]{background:white;border:1px solid var(--hig-color-separator);text-align:center}.chat-sidebar [data-ck-chat=\"list\"]{flex:1;overflow:auto;min-height:0}.chat-item{display:block;width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.chat-item[aria-current=page]{background:var(--hig-color-tertiary-system-background,var(--hig-color-separator))}.chat-sidebar p{font-size:12px;color:var(--hig-color-secondary-label);margin:0}.chat-workspace .go-shell{height:100%;min-height:0;max-height:none;border:0;border-radius:0}.chat-workspace .go-toolbar{flex-wrap:nowrap;min-height:52px;padding:8px 20px;gap:12px}.chat-workspace [data-ck-chat=\"title\"]{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:15px}.chat-workspace .go-model-row{max-width:800px;width:100%;box-sizing:border-box;margin-inline:auto}.chat-workspace .go-composer{width:min(100%,800px);box-sizing:border-box;margin-inline:auto;border:0;padding-bottom:max(12px,env(safe-area-inset-bottom))}.chat-workspace [data-ck-chat=\"prompt\"]{border-radius:16px;background:var(--hig-color-secondary-system-background);padding:14px}.chat-workspace [data-ck-chat=\"messages\"]{padding-inline:max(20px,calc((100% - 760px)/2))}.chat-workspace .go-welcome{padding:16px}.chat-workspace .go-welcome h1{font-size:28px}.chat-workspace .go-welcome p{margin:8px}.chat-workspace [data-ck-chat=\"usage\"]{font-size:12px;color:var(--hig-color-secondary-label);padding:4px 20px;text-align:center;margin:0}.chat-workspace .go-model-row label{display:none}.chat-workspace .go-model-row small{font-size:11px}.chat-workspace .go-consent{font-size:11px}.chat-workspace [data-ck-chat=\"history-toggle\"],.chat-workspace [data-ck-chat=\"history-close\"]{display:none}.chat-account{font-size:13px;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.chat-workspace .go-toolbar button{min-height:44px}.chat-sidebar a{min-height:44px;display:flex;align-items:center;font-size:14px}.chat-workspace button:focus-visible{outline:3px solid var(--hig-color-tint);outline-offset:2px}\n@media(max-width:767px){.chat-workspace{grid-template-columns:minmax(0,1fr)}.chat-sidebar{display:none;position:absolute;inset:0;z-index:30}.chat-sidebar.is-open{display:flex}.chat-workspace [data-ck-chat=\"history-toggle\"],.chat-workspace [data-ck-chat=\"history-close\"]{display:block}.chat-workspace .go-toolbar{padding:4px 12px}.chat-workspace .go-model-row{padding:4px 12px}.chat-workspace .go-model-row small{display:none}.chat-workspace .go-composer{padding:8px 12px max(8px,env(safe-area-inset-bottom))}.chat-workspace .go-welcome p{font-size:13px}.chat-workspace [data-ck-chat=\"messages\"]{padding:12px}.chat-account{max-width:110px}.chat-workspace [data-ck-chat=\"usage\"]{padding:2px 8px;font-size:11px}.chat-workspace .go-consent{line-height:1.3}.chat-workspace [data-ck-chat=\"status\"]{margin:2px 0}.chat-workspace .go-compose-actions{padding-block:6px}}\n@media(max-height:650px){.chat-workspace .go-welcome p,.chat-workspace .go-welcome .go-mark{display:none}.chat-workspace .go-welcome h1{font-size:20px}.chat-workspace .go-composer>label:first-child{display:none}}\n\n/* Show the conversation and its next action; reveal secondary information on demand. */\n.chat-workspace .go-composer>label:first-child{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}\n.chat-workspace .go-composer{border:1px solid var(--hig-color-separator);border-radius:var(--hig-radius-lg);width:calc(100% - 32px);max-width:760px;margin-bottom:16px;padding:12px;background:var(--hig-color-system-background)}\n.chat-workspace [data-ck-chat=\"prompt\"]{margin:0;border:0;background:transparent;min-height:72px;padding:8px;outline-offset:0}\n.chat-workspace .go-compose-actions{padding:4px 0;gap:12px;flex-wrap:nowrap}\n.chat-workspace .go-model-row{padding:0;margin:0;width:auto;max-width:calc(100% - 96px);flex:0 1 auto;display:flex;margin-right:auto}\n.chat-workspace [data-ck-chat=\"model\"]{width:auto;min-height:44px;border:0;background:var(--hig-color-secondary-system-background);font-size:14px}\n.chat-workspace .go-consent{align-items:center;font-size:12px;margin-top:8px;gap:8px}\n[data-ck-chat=\"consent-details\"]{border:0;background:transparent;text-decoration:underline;color:inherit;padding:8px;min-height:44px;font:inherit}\n.chat-workspace [data-ck-chat=\"status\"]:empty{display:none}\n.chat-workspace .go-toolbar{border:0;min-height:44px}\n.chat-workspace .go-toolbar:has([data-ck-chat=\"title\"]:empty){visibility:hidden}\n.chat-workspace .chat-sidebar h2{border:0;margin:4px 8px;font-weight:500;color:var(--hig-color-secondary-label)}\n.chat-policy>*{margin-block:12px}.chat-policy button,.chat-policy a{min-height:44px}.chat-policy a{display:flex;align-items:center}.chat-policy [data-ck-chat=\"delete\"]{display:block}\n@media(max-width:767px){.chat-workspace .go-toolbar:has([data-ck-chat=\"title\"]:empty){visibility:visible}.chat-workspace .go-composer{width:calc(100% - 16px);margin-bottom:max(8px,env(safe-area-inset-bottom));padding:8px}.chat-workspace .go-consent{font-size:11px;gap:4px}.chat-workspace .go-welcome h1{font-size:24px}}\n")
