(ns cloud-kotoba-dds.styles)

(def css
  "Shared conversation layout. Load after the jp-go-dds token bridge."
  "\n[hidden]{display:none!important}\n.go-shell{display:flex;flex-direction:column;height:calc(100dvh - 5rem);min-height:36rem;max-height:64rem;border:1px solid var(--hig-color-separator);border-radius:var(--hig-radius-lg);background:var(--hig-color-system-background);overflow:hidden}\n.go-toolbar,.go-model-row,.go-compose-actions{display:flex;align-items:center;gap:var(--hig-spacing-3);padding:var(--hig-spacing-3) var(--hig-spacing-4);flex-wrap:wrap}\n.go-toolbar{justify-content:space-between;border-bottom:1px solid var(--hig-color-separator)}\n.go-free{margin-inline-start:var(--hig-spacing-3);color:var(--hig-color-secondary-label);font-size:var(--hig-text-caption1-font-size)}\n.go-model-row{font-size:var(--hig-text-footnote-font-size)}\n[data-ck-chat=\"model\"]{max-width:100%;min-width:0;flex:1}\n.go-model-row small{flex-basis:100%;color:var(--hig-color-secondary-label)}\n.go-conversation{position:relative;flex:1;min-height:0;display:flex;flex-direction:column}\n.go-welcome{margin:auto;text-align:center;padding:var(--hig-spacing-6) var(--hig-spacing-4)}\n.go-welcome h1{font-size:var(--hig-text-title1-font-size)}\n.go-mark{color:var(--hig-color-tint);font-size:var(--hig-text-large-title-font-size)}\n[data-ck-chat=\"messages\"]{overflow-y:auto;overscroll-behavior:contain;flex:1;min-height:0;padding:var(--hig-spacing-4);scrollbar-gutter:stable}\n[data-ck-chat=\"messages\"]:empty{flex:0;padding:0}\n.go-message{max-width:46rem;margin:0 auto var(--hig-spacing-5);min-width:0;overflow-wrap:anywhere}\n.go-user{background:var(--hig-color-secondary-system-background);border-radius:var(--hig-radius-lg);padding:var(--hig-spacing-4);max-width:38rem;margin-inline-end:0}\n.go-role{display:block;font-weight:600;margin-bottom:var(--hig-spacing-2);font-size:var(--hig-text-footnote-font-size)}\n.go-text{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.7}\n.go-image{display:block;max-width:100%;height:auto;border-radius:var(--hig-radius-md)}\n.go-steps{display:flex;flex-wrap:wrap;gap:var(--hig-spacing-2);padding:0;list-style:none;font-size:var(--hig-text-caption1-font-size);color:var(--hig-color-secondary-label)}\n.go-steps li{border-bottom:2px solid var(--hig-color-separator);padding-block:var(--hig-spacing-2)}\n.go-steps [data-state=current]{color:var(--hig-color-tint);border-color:currentColor;font-weight:600}\n.go-steps [data-state=done]::before{content:'✓ ';}\n.go-turn-status{font-size:var(--hig-text-footnote-font-size);color:var(--hig-color-secondary-label)}\n[data-failed=true] .go-turn-status{color:var(--hig-color-label)}\n.go-actions{display:flex;align-items:center;flex-wrap:wrap;gap:var(--hig-spacing-3);margin-block:var(--hig-spacing-3)}\n.go-actions small{flex-basis:100%;overflow-wrap:anywhere}\n.go-composer{flex-shrink:0;border-top:1px solid var(--hig-color-separator);padding:var(--hig-spacing-3) var(--hig-spacing-4);padding-bottom:max(var(--hig-spacing-3),env(safe-area-inset-bottom))}\n[data-ck-chat=\"prompt\"]{display:block;width:100%;box-sizing:border-box;min-height:3rem;max-height:180px;resize:none;font-size:var(--hig-text-body-font-size);margin-top:var(--hig-spacing-2)}\n.go-compose-actions{padding-inline:0}.go-compose-actions small{margin-inline-start:auto;color:var(--hig-color-secondary-label)}\n.go-consent{display:flex;gap:var(--hig-spacing-2);align-items:flex-start;font-size:var(--hig-text-caption1-font-size);line-height:1.5}.go-consent input{flex-shrink:0;min-width:1.25rem;min-height:1.25rem}\n[data-ck-chat=\"status\"]{min-height:1.5em;margin:var(--hig-spacing-2) 0 0;font-size:var(--hig-text-caption1-font-size)}\n.go-latest{position:absolute;bottom:var(--hig-spacing-2);right:var(--hig-spacing-4)}\n.go-about{margin-block:var(--hig-spacing-5)}\n@media(max-width:600px){.ap:has(.go-shell){padding-inline:var(--hig-spacing-2);padding-top:var(--hig-spacing-2)}.go-shell{height:calc(100dvh - 4.5rem);min-height:30rem;border-radius:var(--hig-radius-md)}.go-toolbar,.go-model-row{padding:var(--hig-spacing-2) var(--hig-spacing-3)}.go-toolbar button{min-height:44px}.go-toolbar .go-free{display:none}.go-composer{padding-inline:var(--hig-spacing-3)}.go-compose-actions small{display:none}.go-compose-actions{justify-content:space-between}[data-ck-chat=\"messages\"]{padding:var(--hig-spacing-3)}.go-welcome{padding:var(--hig-spacing-3)}.go-welcome h1{font-size:var(--hig-text-title2-font-size)}.go-model-row small{margin:0}.go-consent{max-height:4.5rem;overflow:auto}}\n@media(max-height:600px){.go-shell{min-height:24rem}.go-welcome{display:none}.go-consent{max-height:3rem;overflow:auto}}\n\n.go-shell{color-scheme:light}\n.go-shell :focus-visible{outline:2px solid var(--hig-color-tint);outline-offset:3px}\n.go-composer{padding-left:max(var(--hig-spacing-3),env(safe-area-inset-left));padding-right:max(var(--hig-spacing-3),env(safe-area-inset-right))}\n.go-toolbar{padding-top:max(var(--hig-spacing-3),env(safe-area-inset-top))}\n@media(max-width:600px){.go-toolbar{flex-wrap:nowrap}.go-toolbar button{padding:var(--hig-spacing-2);white-space:nowrap}.go-compose-actions{flex-wrap:nowrap}.go-consent{max-height:none;overflow:visible}}\n.chat-workspace [data-ck-chat=\"model\"]{min-height:44px;border:1px solid var(--hig-color-separator);border-radius:10px;padding:8px;background:var(--hig-color-system-background);color:var(--hig-color-label);font-size:14px}\n.chat-workspace [data-ck-chat=\"history-toggle\"]{border:0;border-radius:10px;background:var(--hig-color-secondary-system-background);padding:8px 12px;color:var(--hig-color-label)}\n.chat-policy{max-width:min(640px,calc(100vw - 32px));max-height:80dvh;border:1px solid var(--hig-color-separator);border-radius:20px;padding:20px;overflow:auto}.chat-policy button{min-height:44px}.chat-policy::backdrop{background:rgb(0 0 0 / 40%)}\n/* Conversation workspace: history, messages and a persistent composer. */\nbody:has(.chat-workspace){overflow:hidden}.chat-workspace{display:grid;grid-template-columns:250px minmax(0,1fr);height:calc(100dvh - 65px);max-width:none!important;padding:0!important;margin:0!important;position:relative}.chat-sidebar{display:flex;flex-direction:column;padding:16px;background:var(--hig-color-secondary-system-background);border-right:1px solid var(--hig-color-separator);min-height:0;gap:12px}.chat-sidebar h2{font-size:14px;margin:8px}.chat-sidebar button{min-height:48px;border:0;border-radius:10px;text-align:left;padding:10px 12px;background:transparent;color:var(--hig-color-label);font:inherit}.chat-sidebar [data-ck-chat=\"new\"]{background:var(--hig-color-system-background);border:1px solid var(--hig-color-separator);text-align:center}.chat-sidebar [data-ck-chat=\"list\"]{flex:1;overflow:auto;min-height:0}.chat-item{display:block;width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.chat-item[aria-current=page]{background:var(--hig-color-tertiary-system-background,var(--hig-color-separator))}.chat-sidebar p{font-size:12px;color:var(--hig-color-secondary-label);margin:0}.chat-workspace .go-shell{height:100%;min-height:0;max-height:none;border:0;border-radius:0}.chat-workspace .go-toolbar{flex-wrap:nowrap;min-height:52px;padding:8px 20px;gap:12px}.chat-workspace [data-ck-chat=\"title\"]{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:15px}.chat-workspace .go-model-row{max-width:800px;width:100%;box-sizing:border-box;margin-inline:auto}.chat-workspace .go-composer{width:min(100%,800px);box-sizing:border-box;margin-inline:auto;border:0;padding-bottom:max(12px,env(safe-area-inset-bottom))}.chat-workspace [data-ck-chat=\"prompt\"]{border-radius:16px;background:var(--hig-color-secondary-system-background);padding:14px}.chat-workspace [data-ck-chat=\"messages\"]{padding-inline:max(20px,calc((100% - 760px)/2))}.chat-workspace .go-welcome{padding:16px}.chat-workspace .go-welcome h1{font-size:28px}.chat-workspace .go-welcome p{margin:8px}.chat-workspace [data-ck-chat=\"usage\"]{font-size:12px;color:var(--hig-color-secondary-label);padding:4px 20px;text-align:center;margin:0}.chat-workspace .go-model-row label{display:none}.chat-workspace .go-model-row small{font-size:11px}.chat-workspace .go-consent{font-size:11px}.chat-workspace [data-ck-chat=\"history-toggle\"],.chat-workspace [data-ck-chat=\"history-close\"]{display:none}.chat-account{font-size:13px;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.chat-workspace .go-toolbar button{min-height:44px}.chat-sidebar a{min-height:44px;display:flex;align-items:center;font-size:14px}.chat-workspace button:focus-visible{outline:3px solid var(--hig-color-tint);outline-offset:2px}\n@media(max-width:767px){.chat-workspace{grid-template-columns:minmax(0,1fr)}.chat-sidebar{display:none;position:absolute;inset:0;z-index:30}.chat-sidebar.is-open{display:flex}.chat-workspace [data-ck-chat=\"history-toggle\"],.chat-workspace [data-ck-chat=\"history-close\"]{display:block}.chat-workspace .go-toolbar{padding:4px 12px}.chat-workspace .go-model-row{padding:4px 12px}.chat-workspace .go-model-row small{display:none}.chat-workspace .go-composer{padding:8px 12px max(8px,env(safe-area-inset-bottom))}.chat-workspace .go-welcome p{font-size:13px}.chat-workspace [data-ck-chat=\"messages\"]{padding:12px}.chat-account{max-width:110px}.chat-workspace [data-ck-chat=\"usage\"]{padding:2px 8px;font-size:11px}.chat-workspace .go-consent{line-height:1.3}.chat-workspace [data-ck-chat=\"status\"]{margin:2px 0}.chat-workspace .go-compose-actions{padding-block:6px}}\n@media(max-height:650px){.chat-workspace .go-welcome p,.chat-workspace .go-welcome .go-mark{display:none}.chat-workspace .go-welcome h1{font-size:20px}.chat-workspace .go-composer>label:first-child{display:none}}\n\n/* Show the conversation and its next action; reveal secondary information on demand. */\n.chat-workspace .go-composer>label:first-child{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}\n.chat-workspace .go-composer{border:1px solid var(--hig-color-separator);border-radius:var(--hig-radius-lg);width:calc(100% - 32px);max-width:760px;margin-bottom:16px;padding:12px;background:var(--hig-color-system-background)}\n.chat-workspace [data-ck-chat=\"prompt\"]{margin:0;border:0;background:transparent;min-height:72px;padding:8px;outline-offset:0}\n.chat-workspace .go-compose-actions{padding:4px 0;gap:12px;flex-wrap:nowrap}\n.chat-workspace .go-model-row{padding:0;margin:0;width:auto;max-width:calc(100% - 96px);flex:0 1 auto;display:flex;margin-right:auto}\n.chat-workspace [data-ck-chat=\"model\"]{width:auto;min-height:44px;border:0;background:var(--hig-color-secondary-system-background);font-size:14px}\n.chat-workspace .go-consent{align-items:center;font-size:12px;margin-top:8px;gap:8px}\n[data-ck-chat=\"consent-details\"]{border:0;background:transparent;text-decoration:underline;color:inherit;padding:8px;min-height:44px;font:inherit}\n.chat-workspace [data-ck-chat=\"status\"]:empty{display:none}\n.chat-workspace .go-toolbar{border:0;min-height:44px}\n.chat-workspace .go-toolbar:has([data-ck-chat=\"title\"]:empty){visibility:hidden}\n.chat-workspace .chat-sidebar h2{border:0;margin:4px 8px;font-weight:500;color:var(--hig-color-secondary-label)}\n.chat-policy>*{margin-block:12px}.chat-policy button,.chat-policy a{min-height:44px}.chat-policy a{display:flex;align-items:center}.chat-policy [data-ck-chat=\"delete\"]{display:block}\n@media(max-width:767px){.chat-workspace .go-toolbar:has([data-ck-chat=\"title\"]:empty){visibility:visible}.chat-workspace .go-composer{width:calc(100% - 16px);margin-bottom:max(8px,env(safe-area-inset-bottom));padding:8px}.chat-workspace .go-consent{font-size:11px;gap:4px}.chat-workspace .go-welcome h1{font-size:24px}}\n")

(def bots-css
  "The Bots workspace pattern (`cloud-kotoba-dds.bots`). Load after the
   jp-go-dds token bridge and, for dark, after `jp-go-dds.dark` (or a host
   appearance layer that inverts the primitives): the surface lifts read the
   `--dds-light-*` snapshot names that layer emits.

   Surfaces are four tokens on the root — ground, raised, hover, border — so a
   host retunes the whole pattern by redefining four custom properties on
   `.ck-bots`, not by overriding rules. In light they are the DADS semantic
   surfaces; in dark `light-dark()` lifts raised above ground (the primitive
   inversion alone lands both on the same grey, which reads as flat) using
   `color-mix` over ramp steps — derived, not drawn. No colour literal here."
  (str
   ;; --- surface tokens ---------------------------------------------------
   ".ck-bots{"
   "--ck-bots-ground:light-dark(var(--hig-color-system-grouped-background),color-mix(in srgb,var(--dds-light-neutral-solid-gray-900) 70%,var(--dds-light-neutral-black)));"
   "--ck-bots-raised:light-dark(var(--hig-color-system-background),var(--dds-light-neutral-solid-gray-900));"
   "--ck-bots-hover:light-dark(var(--hig-color-quaternary-system-fill),color-mix(in srgb,var(--dds-light-neutral-solid-gray-900) 60%,var(--dds-light-neutral-solid-gray-800)));"
   "--ck-bots-border:light-dark(var(--hig-color-separator),color-mix(in srgb,var(--dds-light-neutral-solid-gray-900) 45%,var(--dds-light-neutral-solid-gray-800)));"
   "--ck-bots-text:var(--hig-color-label);--ck-bots-muted:var(--hig-color-secondary-label);--ck-bots-accent:var(--hig-color-tint);"
   "--ck-bots-radius:var(--hig-radius-sm);--ck-bots-radius-lg:var(--hig-radius-md);--ck-bots-radius-pill:var(--hig-radius-capsule);"
   "--ck-bots-rail-width:19rem;"
   "display:grid;grid-template-columns:var(--ck-bots-rail-width) minmax(0,1fr);height:100%;min-height:0;color:var(--ck-bots-text);background:var(--ck-bots-ground);font-size:var(--hig-text-subheadline-font-size);line-height:1.6}"
   ".ck-bots *{box-sizing:border-box}"
   ".ck-bots button,.ck-bots input,.ck-bots textarea{font:inherit;color:inherit}"
   ".ck-bots :focus-visible{outline:2px solid var(--ck-bots-accent);outline-offset:2px}"
   ;; --- rail -------------------------------------------------------------
   ".ck-bots__rail{display:flex;flex-direction:column;min-height:0;gap:var(--hig-spacing-2);padding:var(--hig-spacing-3);background:var(--ck-bots-raised);border-inline-end:1px solid var(--ck-bots-border)}"
   ".ck-bots__search{position:relative;flex:none}"
   ".ck-bots__search-mark{position:absolute;inset-inline-start:var(--hig-spacing-3);top:50%;transform:translateY(-50%);color:var(--ck-bots-muted);pointer-events:none}"
   ".ck-bots__search-input{width:100%;min-height:2.75rem;padding:var(--hig-spacing-2) var(--hig-spacing-3) var(--hig-spacing-2) var(--hig-spacing-7);border:1px solid var(--ck-bots-border);border-radius:var(--ck-bots-radius);background:var(--ck-bots-hover);color:var(--ck-bots-text)}"
   ".ck-bots__search-input::placeholder{color:var(--ck-bots-muted)}"
   ".ck-bots__list{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;scrollbar-gutter:stable}"
   ".ck-bots__group{list-style:none;margin:0;padding:0}"
   ".ck-bots__group-label{position:sticky;top:0;z-index:1;margin:0;padding:var(--hig-spacing-2) var(--hig-spacing-2) var(--hig-spacing-1);background:var(--ck-bots-raised);color:var(--ck-bots-muted);font-size:var(--hig-text-caption1-font-size);font-weight:600}"
   ".ck-bots__row{margin:0;padding:0}"
   ".ck-bots__item{display:grid;grid-template-columns:2.5rem minmax(0,1fr) auto;align-items:center;gap:var(--hig-spacing-3);width:100%;min-height:3.5rem;padding:var(--hig-spacing-2) var(--hig-spacing-2);border:0;border-radius:var(--ck-bots-radius);background:transparent;text-align:start;cursor:pointer}"
   ".ck-bots__item:hover,.ck-bots__item.is-current{background:var(--ck-bots-hover)}"
   ".ck-bots__avatar{display:inline-flex;width:2.5rem;height:2.5rem;flex:none;align-items:center;justify-content:center;border-radius:var(--ck-bots-radius-pill)}"
   ".ck-bots__avatar>*{width:100%;height:100%}"
   ".ck-bots__copy{min-width:0}"
   ".ck-bots__headline{display:flex;align-items:baseline;gap:var(--hig-spacing-2)}"
   ".ck-bots__name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:700}"
   ".ck-bots__time{flex:none;color:var(--ck-bots-muted);font-size:var(--hig-text-caption1-font-size);font-variant-numeric:tabular-nums}"
   ".ck-bots__meta{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ck-bots-muted);font-size:var(--hig-text-footnote-font-size)}"
   ".ck-bots__dot{width:.5rem;height:.5rem;border-radius:var(--ck-bots-radius-pill);background:var(--ck-bots-accent)}"
   ".ck-bots__launcher{flex:none;margin-top:auto;padding-top:var(--hig-spacing-2);border-top:1px solid var(--ck-bots-border)}"
   ".ck-bots__launch{display:flex;align-items:center;gap:var(--hig-spacing-2);min-height:2.75rem;padding-inline:var(--hig-spacing-2);border-radius:var(--ck-bots-radius);color:inherit;text-decoration:none}"
   ".ck-bots__launch:hover{background:var(--ck-bots-hover)}"
   ".ck-bots__launch-mark{width:1.25rem;text-align:center;color:var(--ck-bots-muted)}"
   ;; --- main -------------------------------------------------------------
   ".ck-bots__main{display:flex;flex-direction:column;min-height:0;min-width:0;background:var(--ck-bots-ground)}"
   ".ck-bots__titlebar{display:flex;flex-wrap:wrap;align-items:center;gap:var(--hig-spacing-3);min-height:4rem;padding:var(--hig-spacing-3) var(--hig-spacing-5);background:var(--ck-bots-raised);border-bottom:1px solid var(--ck-bots-border)}"
   ".ck-bots__refs{flex:none}"
   ".ck-bots__identity{display:flex;align-items:center;gap:var(--hig-spacing-3);flex:1;min-width:0}"
   ".ck-bots__title-copy{min-width:0}"
   ".ck-bots__title-name{margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:var(--hig-text-headline-font-size);font-weight:700}"
   ".ck-bots__title-status{margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ck-bots-muted);font-size:var(--hig-text-footnote-font-size)}"
   ".ck-bots__actions{display:flex;align-items:center;gap:var(--hig-spacing-2);flex:none;margin-inline-start:auto}"
   ".ck-bots__chip{display:inline-flex;align-items:center;min-height:2rem;padding:0 var(--hig-spacing-3);border:1px solid var(--ck-bots-border);border-radius:var(--ck-bots-radius);background:var(--ck-bots-hover);font-size:var(--hig-text-footnote-font-size);font-weight:600;white-space:nowrap}"
   "button.ck-bots__chip{cursor:pointer}"
   ".ck-bots__action{min-height:2.75rem;padding:0 var(--hig-spacing-4);border:1px solid transparent;border-radius:var(--ck-bots-radius);background:var(--ck-bots-hover);font-weight:600;cursor:pointer;white-space:nowrap}"
   ".ck-bots__action--primary{background:var(--ck-bots-raised);border-color:var(--ck-bots-border)}"
   ".ck-bots__action:hover{border-color:var(--ck-bots-border)}"
   ".ck-bots__disclosure{flex:none;padding:0 var(--hig-spacing-5);border-bottom:1px solid var(--ck-bots-border);background:var(--ck-bots-raised)}"
   ".ck-bots__disclosure-summary{min-height:2.75rem;display:flex;align-items:center;gap:var(--hig-spacing-2);color:var(--ck-bots-muted);cursor:pointer;font-size:var(--hig-text-footnote-font-size)}"
   ".ck-bots__disclosure>:not(summary){padding-bottom:var(--hig-spacing-3)}"
   ".ck-bots__feed{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;padding:var(--hig-spacing-4) var(--hig-spacing-5);display:flex;flex-direction:column;gap:var(--hig-spacing-3)}"
   ".ck-bots__note{margin:0;text-align:center}"
   ".ck-bots__note>*{display:inline-flex;align-items:center;min-height:2rem;padding:0 var(--hig-spacing-3);border-radius:var(--ck-bots-radius);background:var(--ck-bots-hover);color:var(--ck-bots-muted);font-size:var(--hig-text-caption1-font-size)}"
   ".ck-bots__card{display:flex;flex-wrap:wrap;align-items:center;gap:var(--hig-spacing-2) var(--hig-spacing-3);padding:var(--hig-spacing-3) var(--hig-spacing-4);border:1px solid var(--ck-bots-border);border-radius:var(--ck-bots-radius-lg);background:var(--ck-bots-raised)}"
   ".ck-bots__card-title{margin:0;flex:none;font-size:var(--hig-text-subheadline-font-size);font-weight:700}"
   ".ck-bots__tag{display:inline-flex;align-items:center;min-height:1.5rem;padding:0 var(--hig-spacing-2);border-radius:var(--ck-bots-radius-pill);background:var(--ck-bots-hover);font-size:var(--hig-text-caption2-font-size);font-weight:600;white-space:nowrap}"
   ".ck-bots__tag[data-state=ok]{color:var(--color-semantic-success-1)}"
   ".ck-bots__tag[data-state=error]{color:var(--color-semantic-error-1)}"
   ".ck-bots__tag[data-state=warn]{color:var(--color-semantic-warning-orange-1)}"
   ".ck-bots__card-summary{flex:1 1 12rem;min-width:0;margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}"
   ".ck-bots__card-more{flex:none;margin-inline-start:auto;font-size:var(--hig-text-footnote-font-size)}"
   ".ck-bots__card-more>*{color:var(--ck-bots-accent);background:transparent;border:0;padding:var(--hig-spacing-2);min-height:2.75rem;cursor:pointer;text-decoration:none}"
   ".ck-bots__bubble{max-width:46rem;padding:var(--hig-spacing-3) var(--hig-spacing-4);border:1px solid var(--ck-bots-border);border-radius:var(--ck-bots-radius-lg);background:var(--ck-bots-raised);white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.7}"
   ".ck-bots__bubble[data-role=person]{margin-inline-start:auto;background:var(--ck-bots-accent);color:var(--hig-color-system-background);border-color:transparent}"
   ;; --- composer ---------------------------------------------------------
   ".ck-bots__composer{flex:none;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:var(--hig-spacing-2) var(--hig-spacing-3);align-items:end;width:min(100%,52rem);margin-inline:auto;padding:var(--hig-spacing-3) var(--hig-spacing-5) max(var(--hig-spacing-4),env(safe-area-inset-bottom))}"
   ".ck-bots__prompt{grid-column:1;width:100%;min-height:5rem;max-height:40dvh;padding:var(--hig-spacing-3) var(--hig-spacing-4);border:1px solid var(--ck-bots-border);border-radius:var(--ck-bots-radius-lg);background:var(--ck-bots-raised);resize:vertical}"
   ".ck-bots__prompt::placeholder{color:var(--ck-bots-muted)}"
   ".ck-bots__send{grid-column:2;min-height:2.75rem;padding:0 var(--hig-spacing-4);border:1px solid var(--ck-bots-border);border-radius:var(--ck-bots-radius);background:var(--ck-bots-hover);font-weight:600;cursor:pointer;white-space:nowrap}"
   ".ck-bots__send:disabled{color:var(--ck-bots-muted);cursor:default}"
   ".ck-bots__hint{grid-column:1/-1;margin:0;color:var(--ck-bots-muted);font-size:var(--hig-text-caption1-font-size)}"
   ".ck-bots__rail-toggle{display:none;min-height:2.75rem;padding:0 var(--hig-spacing-3);border:1px solid var(--ck-bots-border);border-radius:var(--ck-bots-radius);background:var(--ck-bots-hover);cursor:pointer}"
   ;; --- the narrow band: the rail is a sheet over the main column ----------
   "@media(max-width:47.99rem){"
   ".ck-bots{grid-template-columns:minmax(0,1fr)}"
   ".ck-bots__rail{display:none}"
   ".ck-bots.show-rail>.ck-bots__rail{display:flex}.ck-bots.show-rail>.ck-bots__main{display:none}"
   ".ck-bots__rail-toggle{display:inline-flex;align-items:center}"
   ".ck-bots__titlebar{padding:var(--hig-spacing-2) var(--hig-spacing-3);min-height:3.5rem}"
   ".ck-bots__title-name{font-size:var(--hig-text-subheadline-font-size)}"
   ".ck-bots__actions{gap:var(--hig-spacing-1)}"
   ".ck-bots__feed{padding:var(--hig-spacing-3)}"
   ".ck-bots__composer{padding:var(--hig-spacing-2) var(--hig-spacing-3) max(var(--hig-spacing-3),env(safe-area-inset-bottom))}"
   ".ck-bots__hint{display:none}"
   ".ck-bots__card-summary{white-space:normal;flex-basis:100%}"
   "}"
   ;; --- phones: one column of rows, the titlebar wraps, the prompt is shorter
   "@media(max-width:30rem){"
   ".ck-bots__item{grid-template-columns:2.25rem minmax(0,1fr) auto;min-height:3.25rem}"
   ".ck-bots__avatar{width:2.25rem;height:2.25rem}"
   ".ck-bots__actions{flex-wrap:wrap;margin-inline-start:0;width:100%}"
   ".ck-bots__prompt{min-height:4rem}"
   ".ck-bots__send{min-width:4rem}"
   "}"
   "@media(prefers-reduced-motion:reduce){.ck-bots *{transition:none;animation:none}}"))
